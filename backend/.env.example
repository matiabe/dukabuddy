# PostgreSQL connection (docker-compose.yml starts a matching database).
# The password must match POSTGRES_PASSWORD in the project-root .env (default: dukabuddy_dev)
DATABASE_URL=postgresql://dukabuddy:dukabuddy_dev@127.0.0.1:5432/dukabuddy

# AI assistant (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Email alerts & monthly reports (optional - without these, alerts are kept in the in-app outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Default owner email (can also be set in Alerts & Settings)
OWNER_EMAIL=

# How often the background automation runs
AUTOMATION_INTERVAL_MINUTES=60

# SMS alerts to boss & staff via Africa's Talking (optional - without these, SMS are only kept in the app's SMS log)
# Sign up at africastalking.com, buy SMS credit, create an API key. Use AT_USERNAME=sandbox to test for free
# (messages then appear in their online simulator, not on real phones).
AT_USERNAME=
AT_API_KEY=
# Optional approved sender name (e.g. NYAMSCOMM). Leave empty to send from Africa's Talking's shared number.
AT_SENDER_ID=

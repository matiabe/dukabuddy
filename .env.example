# Copy to .env (same folder as docker-compose.yml). Never commit .env.

# Database password. Change it before the first start; if you change it later you must also
# change it inside PostgreSQL (or reset the database).
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Port staff devices use: http://<this computer's IP>  (if 80 is taken, use 8080 -> http://<IP>:8080)
APP_PORT=80

# 0 = real shop (starts empty, import your products). 1 = sample electronics shop for trying things out.
DEMO_DATA=0
